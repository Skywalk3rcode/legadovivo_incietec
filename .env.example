# ==============================================================
# LegadoVivo - Variables de Entorno del Sistema
# ==============================================================

# Entorno
ENVIRONMENT=development
DEBUG=True
API_PORT=8080

# PostgreSQL (SQLAlchemy)
POSTGRES_USER=legado_admin
POSTGRES_PASSWORD=12345
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legadovivo_db
# URL async: postgresql+asyncpg://user:pass@host:port/db
# URL sync:  postgresql+psycopg2://user:pass@host:port/db
POSTGRES_URL=postgresql+psycopg2://legado_admin:legado_secure_pass_2026@localhost:5432/legadovivo_db

# MongoDB (Motor / PyMongo)
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_secure_pass_2026
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=legadovivo_nosql
MONGO_URI=mongodb://mongo_admin:mongo_secure_pass_2026@localhost:27017/?authSource=admin

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./chroma_storage

# Ollama LLM & Embeddings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Seguridad y CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=legadovivo_super_secret_jwt_key_change_in_production
ALGORITHM=HS256

# ==============================================================
# Supabase Auth
# ==============================================================
# Obtén estos valores desde tu proyecto Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings


